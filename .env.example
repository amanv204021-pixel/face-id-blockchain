# ═══════════════════════════════════════════════════════════════
#  FACE ID + BLOCKCHAIN VERIFICATION — environment template
#  Copy to backend/.env (or export) and fill ONLY what you need.
#  Everything works out-of-the-box with NO credentials (DEMO MODE).
# ═══════════════════════════════════════════════════════════════

# --- Reverse image search -------------------------------------
# demo          → local fixture index (synthetic images, clearly labeled)
# google_vision → Google Cloud Vision WEB_DETECTION (official API)
REVERSE_SEARCH_PROVIDER=demo
GOOGLE_VISION_API_KEY=

# --- Blockchain (optional — defaults to local simulated chain) -
# For live anchoring set ALL THREE + install web3:
#   pip install web3
# Use a TESTNET wallet. Never commit real keys.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Frontend (vite dev proxies /api → 127.0.0.1:8000) --------
# VITE_API_BASE=            # only needed if you move the backend
